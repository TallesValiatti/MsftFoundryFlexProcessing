# Reference list of the environment variables read by the demo.
# Copy this file to .env (git-ignored) and fill in your values:
#   cp .env.example .env
# The app loads .env from the current directory at startup (run it from the repository root).
# Variables already set in your shell take precedence over the file.

# Required
AZURE_OPENAI_ENDPOINT=https://<RESOURCE_NAME>.openai.azure.com
AZURE_OPENAI_API_KEY=<YOUR_API_KEY>
AZURE_OPENAI_DEPLOYMENT=<YOUR_DEPLOYMENT_NAME>

# Optional: Standard fallback after a Flex HTTP 429 (default: false)
FLEX_FALLBACK_ENABLED=false

# Optional: client timeout in seconds (default: 900 = 15 minutes)
REQUEST_TIMEOUT_SECONDS=900

# Optional: prices in USD per 1M tokens (Global Standard, short context up to 272K input tokens).
# If unset, the GPT-5.6 Luna values below are used.
# Verify current rates at https://azure.microsoft.com/pricing/details/cognitive-services/openai-service/
STANDARD_INPUT_PRICE_PER_MILLION=0.20
STANDARD_CACHED_INPUT_PRICE_PER_MILLION=0.02
STANDARD_OUTPUT_PRICE_PER_MILLION=1.20

# Flex: 50% of the Standard rates.
FLEX_INPUT_PRICE_PER_MILLION=0.10
FLEX_CACHED_INPUT_PRICE_PER_MILLION=0.01
FLEX_OUTPUT_PRICE_PER_MILLION=0.60
